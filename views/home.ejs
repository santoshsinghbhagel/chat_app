<%- include('partials/header') %>

<div class="landing-page" style="display: flex; flex-direction: column; gap: 3.5rem; align-items: center; justify-content: center; min-height: 75vh; padding: 3rem 0; animation: fadeIn 0.6s ease-out;">
  
  <!-- Hero Section -->
  <div class="hero-section" style="text-align: center; max-width: 850px; padding: 0 1.5rem;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.25rem; background: var(--primary-light); color: var(--primary-dark); border-radius: 99px; font-weight: 600; font-size: 0.95rem; margin-bottom: 1.75rem; border: 1px solid rgba(34, 197, 94, 0.2);">
      <span style="display: inline-block; width: 8px; height: 8px; background: var(--primary); border-radius: 50%; box-shadow: 0 0 8px var(--primary);"></span>
      Real-time Communication
    </div>
    
    <h1 style="font-size: clamp(3rem, 5vw, 4.5rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.5rem; color: var(--text); letter-spacing: -0.03em;">
      Welcome to <br/>
      <span style="background: linear-gradient(135deg, var(--primary), #10b981, #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Santosh Chat</span>
    </h1>
    
    <p style="font-size: 1.25rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 2.5rem; max-width: 650px; margin-left: auto; margin-right: auto;">
      Experience seamless, instant group messaging. Connect with others instantly without the hassle of creating an account.
    </p>
    
    <div class="stats-bar" style="display: inline-flex; align-items: center; gap: 1.25rem; background: var(--surface); padding: 1.25rem 2.5rem; border-radius: 24px; box-shadow: var(--shadow-lg); border: 1px solid var(--border); transition: transform 0.3s ease;">
      <div style="font-size: 2.5rem; color: var(--primary);"><i class="fa-solid fa-comments"></i></div>
      <div style="text-align: left;">
        <div style="font-size: 2rem; font-weight: 800; line-height: 1; color: var(--text);"><%= groupsCount %></div>
        <div style="font-size: 0.95rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem;">Active Group<%= groupsCount !== 1 ? 's' : '' %></div>
      </div>
    </div>
  </div>

  <!-- Actions Grid -->
  <div class="action-cards" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; width: 100%; max-width: 950px; padding: 0 1.5rem;">
    <!-- User Card -->
    <div class="card hover-card" style="padding: 3.5rem 2.5rem; text-align: center; border-radius: 24px; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); background: linear-gradient(145deg, var(--surface), var(--primary-light)); border: 1px solid rgba(34, 197, 94, 0.3); position: relative; overflow: hidden; box-shadow: 0 10px 30px -10px rgba(34, 197, 94, 0.2);">
      <div style="position: absolute; top: -30px; right: -30px; font-size: 14rem; opacity: 0.04; color: var(--primary); transform: rotate(-15deg); pointer-events: none;"><i class="fa-solid fa-users"></i></div>
      
      <div style="width: 80px; height: 80px; background: white; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem; font-size: 2.5rem; color: var(--primary); box-shadow: var(--shadow); transform: rotate(5deg);">
        <i class="fa-solid fa-users" style="transform: rotate(-5deg);"></i>
      </div>
      
      <h2 style="font-size: 1.8rem; margin-bottom: 1rem; color: var(--text); font-weight: 700;">Join a Chat</h2>
      <p style="color: var(--text-muted); margin-bottom: 2.5rem; font-size: 1.1rem; line-height: 1.6;">Browse available groups and join the conversation instantly. No sign-up required.</p>
      
      <a href="/chat/groups" class="btn btn-full" style="padding: 1.1rem; font-size: 1.15rem; border-radius: 14px; box-shadow: 0 8px 20px -6px rgba(34, 197, 94, 0.5);">
        View Groups <i class="fa-solid fa-arrow-right" style="margin-left: 0.5rem;"></i>
      </a>
    </div>
    
    <!-- Admin Card -->
    <div class="card hover-card" style="padding: 3.5rem 2.5rem; text-align: center; border-radius: 24px; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); background: var(--surface); border: 1px solid var(--border); position: relative; overflow: hidden; box-shadow: var(--shadow-lg);">
      <div style="position: absolute; top: -30px; right: -30px; font-size: 14rem; opacity: 0.02; color: var(--text); transform: rotate(-15deg); pointer-events: none;"><i class="fa-solid fa-user-shield"></i></div>
      
      <div style="width: 80px; height: 80px; background: var(--bg); border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem; font-size: 2.5rem; color: var(--text-muted); border: 1px solid var(--border); transform: rotate(-5deg);">
        <i class="fa-solid fa-user-shield" style="transform: rotate(5deg);"></i>
      </div>
      
      <h2 style="font-size: 1.8rem; margin-bottom: 1rem; color: var(--text); font-weight: 700;">Admin Portal</h2>
      <p style="color: var(--text-muted); margin-bottom: 2.5rem; font-size: 1.1rem; line-height: 1.6;">Log in securely to create, edit, and manage the chat groups for your users.</p>
      
      <a href="/admin/login" class="btn btn-outline btn-full" style="padding: 1.1rem; font-size: 1.15rem; border-radius: 14px; border-width: 2px; background: transparent;">
        <i class="fa-solid fa-lock" style="margin-right: 0.5rem;"></i> Admin Login
      </a>
    </div>
  </div>
</div>

<style>
  .hover-card:hover {
    transform: translateY(-10px) scale(1.02);
  }
  .stats-bar:hover {
    transform: translateY(-5px);
  }
</style>

<%- include('partials/footer') %>
