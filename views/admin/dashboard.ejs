<%- include('../partials/header') %>

<div class="dashboard">
  <div class="dashboard-header" style="background: linear-gradient(135deg, var(--primary), var(--primary-dark)); padding: 2.5rem; border-radius: var(--radius); color: white; margin-bottom: 2.5rem; box-shadow: var(--shadow-lg);">
    <div style="flex: 1;">
      <h2 style="color: white; font-size: 2.2rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-gauge-high"></i> Admin Dashboard</h2>
      <p style="color: rgba(255,255,255,0.9); font-size: 1.1rem;">Welcome back, <strong><%= admin.username %></strong>. Manage your chat groups efficiently.</p>
    </div>
    <div style="align-self: flex-start;">
      <a href="/admin/logout" class="btn btn-outline" style="color: white !important; border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.1); backdrop-filter: blur(5px);">
        <i class="fa-solid fa-right-from-bracket"></i> Logout
      </a>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem;">
    <!-- Create Group Sidebar -->
    <div class="sidebar">
      <div class="card create-group-card" style="position: sticky; top: 100px;">
        <h3 style="margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border);"><i class="fa-solid fa-plus-circle"></i> Create New Group</h3>
        <form action="/admin/groups" method="POST" class="create-group-form">
          <div class="form-group">
            <label>Group Name <span style="color: var(--error)">*</span></label>
            <input type="text" name="name" placeholder="E.g., General Chat" required maxlength="150" style="padding: 0.85rem;">
          </div>
          <div class="form-group">
            <label>Description</label>
            <input type="text" name="description" placeholder="What is this group about?" style="padding: 0.85rem;">
          </div>
          <div class="form-group">
            <label>Status</label>
            <select name="is_enable" class="form-select" style="padding: 0.85rem;">
              <option value="y">Active (Enabled)</option>
              <option value="n">Inactive (Disabled)</option>
            </select>
          </div>
          <button type="submit" class="btn btn-full" id="create-btn" style="padding: 0.85rem; font-size: 1.05rem; margin-top: 1rem;">
            <i class="fa-solid fa-plus"></i> Create Group
          </button>
        </form>
      </div>
    </div>

    <!-- Manage Groups Main Area -->
    <div class="main-content">
      <div class="card" style="background: transparent; border: none; box-shadow: none; padding: 0;">
        <div class="manage-header" style="background: var(--surface); padding: 1.5rem 2rem; border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 1.5rem; border: 1px solid var(--border);">
          <h3 style="margin: 0; font-size: 1.4rem;"><i class="fa-solid fa-layer-group"></i> Manage Existing Groups</h3>
          <span class="badge" style="font-size: 1rem; padding: 0.4rem 1rem;"><%= groups.length %> group<%= groups.length !== 1 ? 's' : '' %></span>
        </div>
        
        <% if (groups.length === 0) { %>
          <div class="card empty-state" style="padding: 5rem 2rem;">
            <i class="fa-solid fa-folder-open fa-4x" style="color: var(--primary-light);"></i>
            <p style="font-size: 1.3rem; margin-top: 1rem;">No groups available yet.</p>
            <span class="text-muted">Use the form on the left to create your first group.</span>
          </div>
        <% } else { %>
          <div class="group-list" style="gap: 1.25rem;">
          <% groups.forEach(group => { %>
            <div class="group-list-item card" style="padding: 1.5rem; transition: transform 0.2s, box-shadow 0.2s;">
              <form action="/admin/groups/<%= group.id %>/update" method="POST" class="group-list-form" style="padding: 0;">
                <div class="group-list-fields" style="display: grid; grid-template-columns: 2fr 3fr 1.5fr; gap: 1.5rem; align-items: start; margin-bottom: 1.5rem;">
                  <div class="gl-field">
                    <label class="gl-label">Group Name</label>
                    <input type="text" name="name" value="<%= group.name %>" required maxlength="150" style="padding: 0.75rem;">
                  </div>
                  <div class="gl-field">
                    <label class="gl-label">Description</label>
                    <input type="text" name="description" value="<%= group.description || '' %>" placeholder="No description" style="padding: 0.75rem;">
                  </div>
                  <div class="gl-field">
                    <label class="gl-label">Status</label>
                    <select name="is_enable" class="form-select" style="padding: 0.75rem;">
                      <option value="y" <%= group.is_enable === 'y' ? 'selected' : '' %>>Enabled</option>
                      <option value="n" <%= group.is_enable === 'n' ? 'selected' : '' %>>Disabled</option>
                    </select>
                  </div>
                </div>
                <div class="group-list-actions" style="border-top: 1px solid var(--border); padding-top: 1.25rem; display: flex; justify-content: flex-end; gap: 1rem;">
                  <button type="submit" class="btn btn-outline" title="Save changes" style="padding: 0.6rem 1.25rem;">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                  </button>
                  <button type="submit" class="btn btn-danger" title="Delete group"
                          formaction="/admin/groups/<%= group.id %>/delete"
                          onclick="return confirm('Are you sure you want to delete &quot;<%= group.name %>&quot;? All messages will be permanently lost.');" style="padding: 0.6rem 1.25rem;">
                    <i class="fa-solid fa-trash"></i> Delete
                  </button>
                </div>
              </form>
            </div>
          <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
